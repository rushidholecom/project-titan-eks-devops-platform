pipeline {
  agent any

  options {
    disableConcurrentBuilds()
    timestamps()
    timeout(time: 90, unit: 'MINUTES')
  }

  parameters {
    booleanParam(name: 'APPLY_TERRAFORM', defaultValue: true, description: 'Run terraform apply before building and deploying the application.')
    string(name: 'TF_VARS_FILE', defaultValue: 'VARS/dev.tfvars', description: 'Terraform variable file path relative to terraform/.')
    string(name: 'IMAGE_TAG', defaultValue: 'v1', description: 'Docker image tag used for backend/frontend deployment.')
    string(name: 'APP_HOST', defaultValue: 'app.example.com', description: 'Public DNS name for the frontend ingress rule.')
    string(name: 'API_HOST', defaultValue: 'api.example.com', description: 'Public DNS name for the backend ingress rule.')
    string(name: 'BACKEND_IMAGE', defaultValue: 'rushidholecom/rushi-backend:latest', description: 'Full Docker Hub image reference for the backend.')
    string(name: 'FRONTEND_IMAGE', defaultValue: 'rushidholecom/rushi-frontend:v1', description: 'Full Docker Hub image reference for the frontend.')
    string(name: 'BACKEND_ROLLOUT_TIMEOUT', defaultValue: '10m', description: 'Timeout for backend rollout status checks.')
    string(name: 'BACKEND_ROLLOUT_RETRIES', defaultValue: '2', description: 'Number of backend rollout retry attempts.')
    string(name: 'ALB_CONTROLLER_TIMEOUT', defaultValue: '10m', description: 'Timeout for AWS Load Balancer Controller rollout checks.')
    string(name: 'INGRESS_ADDRESS_TIMEOUT_SECONDS', defaultValue: '900', description: 'How long to wait for the ingress ALB address, in seconds.')
  }

  environment {
    TF_IN_AUTOMATION = 'true'
    K8S_NAMESPACE = 'titan'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Verify Toolchain') {
      steps {
        sh '''
          set -e
          terraform version
          aws --version
          kubectl version --client
          envsubst --version
        '''
      }
    }

    stage('Terraform Init And Plan') {
      steps {
        sh '''
          #!/bin/bash
          set -euo pipefail
          rm -rf .terraform
          terraform -chdir=terraform init -backend-config=backend.hcl.example
          terraform -chdir=terraform validate
          terraform -chdir=terraform plan -var-file="${TF_VARS_FILE}"
        '''
      }
    }

    stage('Terraform Apply') {
      when {
        expression { return params.APPLY_TERRAFORM }
      }
      steps {
        input message: 'Approve Terraform apply for this build?'
        sh '''
          #!/bin/bash
          set -euo pipefail
          terraform -chdir=terraform apply -auto-approve -var-file="${TF_VARS_FILE}"
        '''
      }
    }

    stage('Fetch Terraform Outputs') {
      steps {
        script {
          env.AWS_REGION = sh(script: 'terraform -chdir=terraform output -raw aws_region', returnStdout: true).trim()
          env.EKS_CLUSTER_NAME = sh(script: 'terraform -chdir=terraform output -raw eks_cluster_name', returnStdout: true).trim()
          env.RDS_ENDPOINT = sh(script: 'terraform -chdir=terraform output -raw rds_endpoint', returnStdout: true).trim()
          env.RDS_PORT = sh(script: 'terraform -chdir=terraform output -raw rds_port', returnStdout: true).trim()
          env.RDS_DB_NAME = sh(script: 'terraform -chdir=terraform output -raw rds_db_name', returnStdout: true).trim()
          env.DB_USERNAME = sh(script: 'terraform -chdir=terraform output -raw rds_username', returnStdout: true).trim()
          env.DB_PASSWORD = sh(script: 'terraform -chdir=terraform output -raw rds_password', returnStdout: true).trim()
          env.IMAGE_TAG = params.IMAGE_TAG.trim()
          env.BACKEND_IMAGE = params.BACKEND_IMAGE.trim()
          env.FRONTEND_IMAGE = params.FRONTEND_IMAGE.trim()
          if (!env.BACKEND_IMAGE) {
            env.BACKEND_IMAGE = "rushidholecom/rushi-backend:${env.IMAGE_TAG}"
          }
          if (!env.FRONTEND_IMAGE) {
            env.FRONTEND_IMAGE = "rushidholecom/rushi-frontend:${env.IMAGE_TAG}"
          }
          echo "Resolved RDS endpoint: ${env.RDS_ENDPOINT}:${env.RDS_PORT}"
        }
      }
    }

    stage('Deploy To EKS') {
      steps {
        script {
          sh '''
            #!/bin/bash
            set -euo pipefail

            aws eks update-kubeconfig --region "${AWS_REGION}" --name "${EKS_CLUSTER_NAME}"

            rm -rf .rendered-k8s
            mkdir -p .rendered-k8s

            export RDS_ENDPOINT="${RDS_ENDPOINT}"
            export RDS_PORT="${RDS_PORT}"
            export RDS_DB_NAME="${RDS_DB_NAME}"
            export BACKEND_IMAGE="${BACKEND_IMAGE}"
            export FRONTEND_IMAGE="${FRONTEND_IMAGE}"
            export APP_HOST="${APP_HOST}"
            export API_HOST="${API_HOST}"
            export DB_USERNAME="${DB_USERNAME}"
            export DB_PASSWORD="${DB_PASSWORD}"

            envsubst < k8s/backend-configmap.yaml > .rendered-k8s/backend-configmap.yaml
            envsubst < k8s/backend-secret.yaml > .rendered-k8s/backend-secret.yaml
            envsubst < k8s/backend-deployment.yaml > .rendered-k8s/backend-deployment.yaml
            envsubst < k8s/frontend-deployment.yaml > .rendered-k8s/frontend-deployment.yaml
            envsubst < k8s/ingress.yaml > .rendered-k8s/ingress.yaml

            kubectl apply -f k8s/namespace.yaml
            kubectl apply -f .rendered-k8s/backend-configmap.yaml
            kubectl apply -f .rendered-k8s/backend-secret.yaml
            kubectl apply -f .rendered-k8s/backend-deployment.yaml
            kubectl apply -f k8s/backend-service.yaml
            kubectl apply -f k8s/backend-hpa.yaml
            kubectl apply -f .rendered-k8s/frontend-deployment.yaml
            kubectl apply -f k8s/frontend-service.yaml
            kubectl apply -f k8s/frontend-hpa.yaml
            kubectl apply -f .rendered-k8s/ingress.yaml

            kubectl get pods -n "${K8S_NAMESPACE}"

            ALB_CONTROLLER_TIMEOUT="${ALB_CONTROLLER_TIMEOUT:-10m}"
            if ! kubectl rollout status deployment/aws-load-balancer-controller -n kube-system --timeout=${ALB_CONTROLLER_TIMEOUT}; then
              echo "=== AWS LOAD BALANCER CONTROLLER DIAGNOSTICS ==="
              kubectl get deployment -n kube-system aws-load-balancer-controller -o wide || true
              kubectl get pods -n kube-system -l app.kubernetes.io/name=aws-load-balancer-controller -o wide || true
              kubectl describe deployment -n kube-system aws-load-balancer-controller || true
              kubectl logs -n kube-system deployment/aws-load-balancer-controller --tail=100 || true
              exit 1
            fi

            BACKEND_ROLLOUT_TIMEOUT="${BACKEND_ROLLOUT_TIMEOUT:-10m}"
            BACKEND_ROLLOUT_RETRIES="${BACKEND_ROLLOUT_RETRIES:-2}"
            backend_success=1
            for attempt in $(seq 1 ${BACKEND_ROLLOUT_RETRIES}); do
              echo "Backend rollout attempt ${attempt}/${BACKEND_ROLLOUT_RETRIES}"
              if kubectl rollout status deployment/titan-backend -n "${K8S_NAMESPACE}" --timeout=${BACKEND_ROLLOUT_TIMEOUT}; then
                backend_success=0
                break
              fi
              if [ "${attempt}" -lt "${BACKEND_ROLLOUT_RETRIES}" ]; then
                echo "Backend rollout did not complete yet; retrying in 10s..."
                sleep 10
              fi
            done
            if [ "${backend_success}" -ne 0 ]; then
              echo "=== BACKEND DIAGNOSTICS ==="
              kubectl get pods -n "${K8S_NAMESPACE}" -l app.kubernetes.io/name=titan-backend -o wide
              kubectl describe pods -n "${K8S_NAMESPACE}" -l app.kubernetes.io/name=titan-backend
              kubectl logs -n "${K8S_NAMESPACE}" -l app.kubernetes.io/name=titan-backend --tail=50 || true
              exit 1
            fi

            if ! kubectl rollout status deployment/titan-frontend -n "${K8S_NAMESPACE}" --timeout=5m ; then
              echo "=== FRONTEND DIAGNOSTICS ==="
              kubectl get pods -n "${K8S_NAMESPACE}" -l app.kubernetes.io/name=titan-frontend -o wide
              kubectl describe pods -n "${K8S_NAMESPACE}" -l app.kubernetes.io/name=titan-frontend
              kubectl logs -n "${K8S_NAMESPACE}" -l app.kubernetes.io/name=titan-frontend --tail=50 || true
              exit 1
            fi

            INGRESS_ADDRESS_TIMEOUT_SECONDS="${INGRESS_ADDRESS_TIMEOUT_SECONDS:-900}"
            ingress_address=""
            deadline=$(( $(date +%s) + INGRESS_ADDRESS_TIMEOUT_SECONDS ))
            while [ "$(date +%s)" -lt "${deadline}" ]; do
              ingress_address="$(kubectl get ingress titan-ingress -n "${K8S_NAMESPACE}" -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || true)"
              if [ -z "${ingress_address}" ]; then
                ingress_address="$(kubectl get ingress titan-ingress -n "${K8S_NAMESPACE}" -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null || true)"
              fi
              if [ -n "${ingress_address}" ]; then
                echo "Ingress address resolved: ${ingress_address}"
                break
              fi
              echo "Waiting for ALB address on titan-ingress..."
              sleep 15
            done

            if [ -z "${ingress_address}" ]; then
              echo "=== INGRESS DIAGNOSTICS ==="
              kubectl get ingress -n "${K8S_NAMESPACE}" -o wide || true
              kubectl describe ingress titan-ingress -n "${K8S_NAMESPACE}" || true
              kubectl get events -n "${K8S_NAMESPACE}" --sort-by=.metadata.creationTimestamp || true
              kubectl logs -n kube-system deployment/aws-load-balancer-controller --tail=150 || true
              exit 1
            fi

            kubectl get ingress -n "${K8S_NAMESPACE}"
          '''
        }
      }
    }
  }
}
